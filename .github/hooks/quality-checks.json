{
  "hooks": [
    {
      "id": "no-secrets-commit",
      "type": "pre-receive",
      "description": "Reject commits that include potential secrets (API keys, passwords).",
      "rules": [
        { "pattern": "(?i)aws_access_key_id|aws_secret_access_key|password=|secret=|api_key=", "action": "reject" }
      ]
    },
    {
      "id": "require-pr-template",
      "type": "pre-push",
      "description": "Ensure PRs generated by automation include PR template sections.",
      "rules": [
        { "pattern": "Summary|Changes Made|Test Evidence|Known Limitations|Reviewer Checklist", "action": "require" }
      ]
    }
  ]
}
